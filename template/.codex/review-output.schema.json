{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "target",
    "summary",
    "findings",
    "areas_reviewed",
    "limitations"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["completed"]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pr_number", "head_sha", "base_ref"],
      "properties": {
        "pr_number": {
          "type": "integer",
          "minimum": 1
        },
        "head_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "base_ref": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,254}$"
        }
      }
    },
    "summary": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "severity",
          "confidence",
          "file",
          "line",
          "title",
          "evidence",
          "failure_scenario",
          "violated_contract",
          "remediation"
        ],
        "properties": {
          "severity": {
            "type": "string",
            "enum": ["P0", "P1", "P2", "P3"]
          },
          "confidence": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          },
          "file": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.][A-Za-z0-9_./()@+ -]*$"
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "failure_scenario": {
            "type": "string"
          },
          "violated_contract": {
            "type": "string"
          },
          "remediation": {
            "type": "string"
          }
        }
      }
    },
    "areas_reviewed": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
